rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection testing
    match /test/{testId} {
      allow read, write: if true;
    }

    // Clients
    match /clients/{clientId} {
      allow get: if isValidId(clientId);
      allow list: if true;
      allow write: if isValidId(clientId);
    }

    // Editors
    match /editors/{editorId} {
      allow get: if isValidId(editorId);
      allow list: if true;
      allow write: if isValidId(editorId);
    }

    // Projects / Work Deliverables
    match /projects/{projectId} {
      allow get: if isValidId(projectId);
      allow list: if true;
      allow write: if isValidId(projectId);
    }

    // Payments (Client payments & Editor payouts)
    match /payments/{paymentId} {
      allow get: if isValidId(paymentId);
      allow list: if true;
      allow write: if isValidId(paymentId);
    }

    // Operational Expenses
    match /expenses/{expenseId} {
      allow get: if isValidId(expenseId);
      allow list: if true;
      allow write: if isValidId(expenseId);
    }

    // Notifications
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId);
      allow list: if true;
      allow write: if isValidId(notificationId);
    }

    // Activities / Audit Trail
    match /activities/{activityId} {
      allow get: if isValidId(activityId);
      allow list: if true;
      allow write: if isValidId(activityId);
    }

    // Revisions
    match /revisions/{revisionId} {
      allow get: if isValidId(revisionId);
      allow list: if true;
      allow write: if isValidId(revisionId);
    }

    // Application & Business Settings
    match /settings/{settingsId} {
      allow get: if isValidId(settingsId);
      allow list: if true;
      allow write: if isValidId(settingsId);
    }

    // Shared Portal Links
    match /sharedLinks/{linkId} {
      allow get: if isValidId(linkId);
      allow list: if true;
      allow write: if isValidId(linkId);
    }

    // Project-Specific Admin-Moderated Live Chat Messages
    match /chatMessages/{messageId} {
      allow get: if isValidId(messageId);
      allow list: if true;
      allow write: if isValidId(messageId);
    }

    // Client & Editor Ratings
    match /ratings/{ratingId} {
      allow get: if isValidId(ratingId);
      allow list: if true;
      allow write: if isValidId(ratingId);
    }

    // Invoices
    match /invoices/{invoiceId} {
      allow get: if isValidId(invoiceId);
      allow list: if true;
      allow write: if isValidId(invoiceId);
    }

    // Receipts
    match /receipts/{receiptId} {
      allow get: if isValidId(receiptId);
      allow list: if true;
      allow write: if isValidId(receiptId);
    }

    // Admin Users
    match /adminUsers/{adminUserId} {
      allow get: if isValidId(adminUserId);
      allow list: if true;
      allow write: if isValidId(adminUserId);
    }

    // Backup History Metadata
    match /backupHistory/{backupId} {
      allow get: if isValidId(backupId);
      allow list: if true;
      allow write: if isValidId(backupId);
    }

    // Calendar Tasks
    match /calendarTasks/{taskId} {
      allow get: if isValidId(taskId);
      allow list: if true;
      allow write: if isValidId(taskId);
    }
  }
}


